digraph system_architecture {
  graph [bgcolor="black" rankdir=TB fontname="Courier New"
         label="sessionarchive — component architecture (single image, single CLI)"
         labelloc=t fontcolor="#00FF41" fontsize=15 pad=0.5 nodesep=0.4 ranksep=0.5];
  node  [style=filled fillcolor="#0a0a0a" fontname="Courier New" fontsize=10 penwidth=2.0];
  edge  [fontname="Courier New" fontsize=9 penwidth=2.0];

  subgraph cluster_image {
    label="one Docker image — ENTRYPOINT [\"sessionarchive\"]"; fontcolor="#00FFFF"; color="#00FFFF"; style=dashed;
    cli    [label="cli.py\nargparse subcommands" color="#00FFFF" fontcolor="#00FFFF" shape=box3d];
    ingest [label="ingest.py" color="#00FFFF" fontcolor="#00FFFF" shape=box];
    query  [label="query.py" color="#00FFFF" fontcolor="#00FFFF" shape=box];
    label_ [label="label.py" color="#00FFFF" fontcolor="#00FFFF" shape=box];
    probe  [label="relevance_probe.py\n(MLPProbe)" color="#00FFFF" fontcolor="#00FFFF" shape=box];
    md     [label="markdown_parsing.py\n(vendored, no external\nrepo dependency)" color="#00FFFF" fontcolor="#00FFFF" shape=box];
    cli -> ingest [color="#00FFFF"]; cli -> query [color="#00FFFF"]; cli -> label_ [color="#00FFFF"];
    query -> probe [color="#00FFFF" style=dashed]; label_ -> probe [color="#00FFFF" style=dashed];
    ingest -> md [color="#00FFFF" style=dashed];
  }

  subgraph cluster_external {
    label="External services"; fontcolor="#FF00FF"; color="#FF00FF"; style=dashed;
    ollama [label="Ollama\nhost.docker.internal:11434\n(external — on the host)" color="#FF00FF" fontcolor="#FF00FF" shape=doubleoctagon];
    neo4j  [label="neo4j container\nbolt://neo4j:7687\n(bundled, own compose service)" color="#FF00FF" fontcolor="#FF00FF" shape=doubleoctagon];
    bgem3  [label="BAAI/bge-m3\ndownloaded to image's\nHF cache on first ingest" color="#FF00FF" fontcolor="#FF00FF" shape=doubleoctagon];
  }

  subgraph cluster_volumes {
    label="Docker volumes"; fontcolor="#7FFF00"; color="#7FFF00"; style=dashed;
    corpusvol [label="./data/corpus\n(read-only mount)" color="#7FFF00" fontcolor="#7FFF00" shape=folder];
    idxvol    [label="./data/index\nindex.faiss, id_map.json,\nrelevance_probe.pt, ..." color="#7FFF00" fontcolor="#7FFF00" shape=cylinder];
  }

  ingest -> ollama [color="#FF00FF"];
  ingest -> bgem3 [color="#FF00FF"];
  ingest -> neo4j [color="#FF00FF"];
  ingest -> corpusvol [color="#7FFF00"];
  ingest -> idxvol [color="#7FFF00"];
  query -> idxvol [color="#7FFF00"];
  query -> neo4j [color="#FF00FF"];
  label_ -> idxvol [color="#7FFF00"];
}
